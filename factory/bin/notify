#!/usr/bin/env python3
"""Send a factory notification to Telegram.

Usage:
  notify < message.txt     send the text on stdin
  notify --test            send a test message and report the result

Called by factory/bin/job whenever a job starts waiting on a person
(needs-info, needs-human), and by the orchestrator when it has to stop a job.
A notification is best-effort: without credentials, or if Telegram fails, it
prints why on stderr and exits 0, so it never blocks the factory. Only
--test exits non-zero on failure.

Turn it on or off with `notify.telegram` in factory/config.json.

Credentials, first match wins:
  1. FACTORY_TELEGRAM_BOT_TOKEN and FACTORY_TELEGRAM_CHAT_ID in the environment.
  2. The Claude Code Telegram plugin's setup: TELEGRAM_BOT_TOKEN from
     ~/.claude/channels/telegram/.env, and the chat id of the single user on
     its allowlist (~/.claude/channels/telegram/access.json). With more than
     one allowlisted user, set FACTORY_TELEGRAM_CHAT_ID.
Secrets are never stored in the repo.
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

REPO = Path(__file__).resolve().parents[2]
CONFIG = json.loads((REPO / "factory" / "config.json").read_text())
PLUGIN_DIR = Path.home() / ".claude" / "channels" / "telegram"
LIMIT = 4000  # Telegram's cap is 4096 characters


def credentials():
    token = os.environ.get("FACTORY_TELEGRAM_BOT_TOKEN")
    chat = os.environ.get("FACTORY_TELEGRAM_CHAT_ID")
    if not token:
        env = PLUGIN_DIR / ".env"
        if env.exists():
            for line in env.read_text().splitlines():
                key, _, value = line.partition("=")
                if key.strip() == "TELEGRAM_BOT_TOKEN":
                    token = value.strip().strip('"').strip("'")
    if not chat:
        access = PLUGIN_DIR / "access.json"
        if access.exists():
            allowed = json.loads(access.read_text()).get("allowFrom", [])
            if len(allowed) == 1:
                chat = str(allowed[0])
    return token, chat


def send(text):
    """Return None on success, or the reason it wasn't sent."""
    if not CONFIG.get("notify", {}).get("telegram", False):
        return "notify.telegram is off in factory/config.json"
    token, chat = credentials()
    if not token or not chat:
        return ("no Telegram credentials: set FACTORY_TELEGRAM_BOT_TOKEN and FACTORY_TELEGRAM_CHAT_ID, "
                "or configure the Telegram plugin with one allowlisted user")
    text = text.strip()
    if len(text) > LIMIT:
        text = text[:LIMIT - 1].rstrip() + "…"
    data = urllib.parse.urlencode({
        "chat_id": chat,
        "text": text,
        "disable_web_page_preview": "true",
    }).encode()
    try:
        with urllib.request.urlopen(f"https://api.telegram.org/bot{token}/sendMessage", data=data, timeout=15) as res:
            body = json.loads(res.read())
        return None if body.get("ok") else f"Telegram refused: {body.get('description')}"
    except urllib.error.HTTPError as e:
        try:
            return f"Telegram refused: {json.loads(e.read()).get('description')}"
        except Exception:
            return f"Telegram refused: HTTP {e.code}"
    except Exception as e:  # network, DNS, timeout
        return f"Telegram unreachable: {type(e).__name__}"


def main(argv):
    if argv and argv[0] in {"-h", "--help"}:
        print(__doc__.strip())
        return 0
    test = argv[:1] == ["--test"]
    text = "Factory: test notification. Telegram notifications work." if test else sys.stdin.read()
    if not text.strip():
        print("notify: no message on stdin", file=sys.stderr)
        return 1 if test else 0
    why = send(text)
    if why:
        print(f"notify: not sent: {why}", file=sys.stderr)
        return 1 if test else 0
    if test:
        print("notify: sent")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
